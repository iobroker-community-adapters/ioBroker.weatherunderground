{
  "name": "iobroker.weatherunderground",
  "version": "4.0.0",
  "description": "weatherunderground forecast",
  "author": "Daniel Schaedler <daniel.schaedler@gmail.com>",
  "contributors": [
    "Dutchman",
    "Apollon77 <iobroker@fischer-ka.de>",
    "DeepCore <devap@deepcore.eu>",
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>"
  ],
  "homepage": "",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "weather",
    "forecast",
    "wu",
    "weatherunderground"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iobroker-community-adapters/ioBroker.weatherunderground"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.8.4"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.0",
    "@module-federation/vite": "^1.23.5",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@types/proxyquire": "^1.3.31",
    "proxyquire": "^2.1.3",
    "react": "^19.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "main": "main.js",
  "files": [
    "main.js",
    "lib/",
    "io-package.json",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}"
  ],
  "scripts": {
    "build": "npm run build:admin",
    "build:admin": "vite build --config admin/vite.config.mjs",
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:unit": "npm run test:js",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script",
    "prepublishOnly": "npm run build"
  },
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.weatherunderground/issues"
  },
  "readmeFilename": "README.md"
}
