{
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "types": ["node", "mocha"],
        // Enable stricter checks separately from adding checks to the existing JavaScript.
        "strict": false
    },
    "include": ["main.js", "lib/**/*.js", "test/**/*.js"]
}
